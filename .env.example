# Default: deterministic demo. No keys or backend needed.
NEXT_PUBLIC_API_MODE=demo
# Only use live after agreeing on docs/API.md with your backend teammate.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional AI: server-only values. Never use NEXT_PUBLIC_ for credentials.
# Copy this file to .env.local; restart the dev server after changing it.
PULSEPOINT_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
